{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "label", "cases"],
  "properties": {
    "schemaVersion": {"const": 1},
    "label": {"const": "synthetic"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "kind": {"enum": ["speed", "inclination", "resistance", "heartRate", "power"]},
    "profile": {"enum": ["uint16Hundredths", "signed16Tenths", "uint8Whole", "uint8Bpm", "signed16Watts"]},
    "status": {"enum": ["valid", "length", "range"]},
    "length": {"type": "integer", "minimum": 0},
    "value": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "minimum", "maximum", "increment", "scaleDivisor", "unit"],
          "properties": {
            "kind": {"$ref": "#/$defs/kind"},
            "minimum": {"type": "integer"}, "maximum": {"type": "integer"},
            "increment": {"type": "integer", "minimum": 1},
            "scaleDivisor": {"enum": [1, 10, 100]}, "unit": {"type": "integer", "minimum": 0, "maximum": 4}
          }
        }
      ]
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "expectedLength", "status", "value"],
      "properties": {
        "profile": {"$ref": "#/$defs/profile"}, "expectedLength": {"enum": [3, 6]},
        "status": {"$ref": "#/$defs/status"}, "value": {"$ref": "#/$defs/value"}
      }
    },
    "report": {
      "type": "object", "additionalProperties": false,
      "required": ["selectedProfile", "actualLength", "expectedLength", "status", "value", "candidates"],
      "properties": {
        "selectedProfile": {"$ref": "#/$defs/profile"}, "actualLength": {"$ref": "#/$defs/length"},
        "expectedLength": {"enum": [3, 6]}, "status": {"$ref": "#/$defs/status"},
        "value": {"$ref": "#/$defs/value"},
        "candidates": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/candidate"}}
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "bytes", "expected"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "kind": {"$ref": "#/$defs/kind"},
        "bytes": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 255}},
        "options": {"type": "object", "additionalProperties": false, "required": ["resistanceFormat"],
          "properties": {"resistanceFormat": {"enum": ["uint8Whole", "signed16Tenths"]}}},
        "expected": {"$ref": "#/$defs/report"}
      }
    }
  }
}
