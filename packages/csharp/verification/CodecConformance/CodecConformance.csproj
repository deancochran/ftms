<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(FtmsAssembly)' != ''">
    <Reference Include="DeanCochran.Ftms">
      <HintPath>$(FtmsAssembly)</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(FtmsAssembly)' == ''">
    <ProjectReference Include="../../src/DeanCochran.Ftms/DeanCochran.Ftms.csproj" />
  </ItemGroup>
</Project>
