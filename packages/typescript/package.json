{
  "name": "@deancochran/ftms",
  "version": "0.6.0",
  "description": "Runtime-neutral TypeScript codecs for Bluetooth Fitness Machine Service (FTMS)",
  "private": false,
  "license": "MIT",
  "author": "Dean Cochran",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deancochran/ftms.git",
    "directory": "packages/typescript"
  },
  "homepage": "https://github.com/deancochran/ftms/tree/main/packages/typescript#readme",
  "bugs": {
    "url": "https://github.com/deancochran/ftms/issues"
  },
  "keywords": [
    "bluetooth",
    "ble",
    "ftms",
    "fitness-machine-service",
    "indoor-cycling",
    "react-native",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "conformance",
    "dist",
    "src",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "react-native": "./dist/index.js",
      "development": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./conformance/schema": "./conformance/v1/schema.json",
    "./conformance/v1": "./conformance/v1/vectors.json",
    "./conformance/v1/schema": "./conformance/v1/schema.json"
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "lint": "pnpm --dir ../.. lint",
    "format": "pnpm --dir ../.. format",
    "test": "vitest run",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "docs:build": "typedoc --options typedoc.json",
    "docs:markdown": "typedoc --options typedoc.markdown.json",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node ./scripts/stage-package.mjs",
    "verify:package": "node ./scripts/verify-package.mjs",
    "test:release": "node --test ./scripts/test-npm-release.mjs",
    "verify": "pnpm lint && pnpm check-types && pnpm test && pnpm verify:package",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm verify"
  },
  "devDependencies": {
    "@types/node": "^20",
    "ajv": "8.18.0",
    "typedoc": "0.28.14",
    "typedoc-plugin-markdown": "4.13.1",
    "typescript": "5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.33.0"
}
