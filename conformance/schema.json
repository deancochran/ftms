{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/deancochran/ftms/main/conformance/schema.json",
  "title": "FTMS conformance vectors",
  "type": "object",
  "required": ["schemaVersion", "sources", "controls", "measurements", "statuses"],
  "properties": {
    "$schema": { "const": "../schema.json" },
    "schemaVersion": { "const": 1 },
    "sources": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "request", "expectedBytes"],
        "properties": {
          "id": { "type": "string" },
          "request": { "type": "object" },
          "expectedBytes": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0, "maximum": 255 }
          }
        },
        "additionalProperties": false
      }
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "characteristicUuid", "bytes", "expectedMetrics"],
        "properties": {
          "id": { "type": "string" },
          "characteristicUuid": { "type": "string" },
          "bytes": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0, "maximum": 255 }
          },
          "expectedMetrics": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "statuses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "characteristicUuid", "bytes", "expectedCode"],
        "properties": {
          "id": { "type": "string" },
          "characteristicUuid": { "type": "string" },
          "bytes": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0, "maximum": 255 }
          },
          "expectedCode": { "type": "integer", "minimum": 0, "maximum": 255 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
