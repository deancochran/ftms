{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ftms:capabilities:conformance:v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "specificationBasis", "snapshots", "reports", "cases"],
  "properties": {
    "schemaVersion": {"const": 1},
    "specificationBasis": {"const": "FTMS 1.0.1 Table 4.1 C.7 (E16264); Tables 4.4, 4.15; ESR11; EC23224"},
    "snapshots": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/snapshot"}},
    "reports": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/report"}},
    "cases": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "category", "input", "expected"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "category": {"enum": ["discovery", "measurements", "features", "ranges", "operations", "properties", "duplicates", "forward-compatibility"]},
        "input": {"$ref": "#/$defs/expansion"}, "expected": {"$ref": "#/$defs/expansion"}
      }
    }}
  },
  "$defs": {
    "u32": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "index": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
    "state": {"type": "integer", "minimum": 0, "maximum": 3},
    "kind": {"type": "integer", "minimum": 0, "maximum": 15},
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "properties": {"type": "integer", "minimum": 0, "maximum": 65535},
    "readState": {"enum": [0, 1, 2]}, "reason": {"enum": [0, 1, 2, 3, 4, 5]},
    "characteristic": {
      "type": "object", "additionalProperties": false,
      "required": ["uuid", "properties", "readState", "reason", "bytes"],
      "properties": {
        "uuid": {"$ref": "#/$defs/uuid"}, "properties": {"$ref": "#/$defs/properties"},
        "readState": {"$ref": "#/$defs/readState"}, "reason": {"$ref": "#/$defs/reason"},
        "bytes": {"type": "string", "pattern": "^(?:[0-9a-f]{2})*$"}
      },
      "allOf": [
        {"if": {"properties": {"readState": {"const": 1}}}, "else": {"properties": {"bytes": {"const": ""}}}},
        {"if": {"properties": {"readState": {"const": 2}}}, "else": {"properties": {"reason": {"const": 0}}}}
      ]
    },
    "snapshot": {
      "type": "object", "additionalProperties": false, "required": ["discovery", "scope", "generation", "characteristics"],
      "properties": {"discovery": {"$ref": "#/$defs/state"}, "scope": {"$ref": "#/$defs/state"},
        "generation": {"$ref": "#/$defs/u32"}, "characteristics": {"type": "array", "items": {"$ref": "#/$defs/characteristic"}},
        "c7": {"type":"object","additionalProperties":false,"required":["bondingSupported","featureMayChangeOverLifetime"],"properties":{"bondingSupported":{"enum":[0,1,2]},"featureMayChangeOverLifetime":{"enum":[0,1,2]}}}}
    },
    "feature": {"type": "array", "minItems": 7, "maxItems": 7, "prefixItems": [
      {"$ref": "#/$defs/state"}, {"$ref": "#/$defs/state"}, {"$ref": "#/$defs/index"},
      {"$ref": "#/$defs/u32"}, {"$ref": "#/$defs/u32"}, {"$ref": "#/$defs/u32"}, {"$ref": "#/$defs/u32"}
    ]},
    "rangeValue": {"type": "array", "minItems": 6, "maxItems": 6, "prefixItems": [
      {"enum": [0,1,2,3,4]}, {"type": "integer", "minimum": -32768, "maximum": 65535},
      {"type": "integer", "minimum": -32768, "maximum": 65535},
      {"type": "integer", "minimum": 1, "maximum": 65535}, {"enum": [1,10,100]}, {"enum": [0,1,2,3,4]}
    ]},
    "range": {"type": "array", "minItems": 4, "maxItems": 4, "prefixItems": [
      {"$ref": "#/$defs/state"}, {"$ref": "#/$defs/state"}, {"$ref": "#/$defs/index"},
      {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/rangeValue"}]}
    ]},
    "operation": {"type": "array", "minItems": 6, "maxItems": 6, "prefixItems": [
      {"type": "integer", "minimum": 0, "maximum": 20}, {"anyOf": [{"const": 255}, {"type": "integer", "minimum": 0, "maximum": 16}]},
      {"enum": [0,1]}, {"enum": [0,1,2]}, {"$ref": "#/$defs/state"}, {"type": "integer", "minimum": 0, "maximum": 2047}
    ]},
    "observation": {"type": "array", "minItems": 7, "maxItems": 7, "prefixItems": [
      {"type": "integer", "minimum": 0}, {"$ref": "#/$defs/uuid"}, {"$ref": "#/$defs/properties"},
      {"$ref": "#/$defs/kind"}, {"$ref": "#/$defs/readState"}, {"$ref": "#/$defs/reason"}, {"type": "integer", "minimum": 0}
    ]},
    "diagnostic": {"type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [
       {"type": "integer", "minimum": 0, "maximum": 12}, {"$ref": "#/$defs/kind"}, {"$ref": "#/$defs/index"}
    ]},
    "report": {
      "type": "object", "additionalProperties": false,
      "required": ["generation", "discovery", "scope", "observationCount", "diagnosticCount", "presence", "feature", "ranges", "operations", "observations", "diagnostics"],
      "properties": {
        "generation": {"$ref": "#/$defs/u32"}, "discovery": {"$ref": "#/$defs/state"}, "scope": {"$ref": "#/$defs/state"},
        "observationCount": {"type": "integer", "minimum": 0}, "diagnosticCount": {"type": "integer", "minimum": 0},
        "presence": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"$ref": "#/$defs/state"}},
        "feature": {"$ref": "#/$defs/feature"},
        "ranges": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/range"}},
        "operations": {"type": "array", "minItems": 21, "maxItems": 21, "items": {"$ref": "#/$defs/operation"}},
        "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}
      }
    },
    "segment": {"anyOf": [
      {"type": "string", "minLength": 1}, {"type": "integer", "minimum": 0},
      {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}
    ]},
    "edit": {"type": "object", "additionalProperties": false, "required": ["path"], "properties": {
      "path": {"type": "array", "items": {"$ref": "#/$defs/segment"}},
      "op": {"enum": ["replace", "append", "remove"]}, "value": {}
    }, "if": {"required": ["op"], "properties": {"op": {"const": "remove"}}},
      "then": {"not": {"required": ["value"]}}, "else": {"required": ["value"]}},
    "expansion": {"type": "object", "additionalProperties": false, "required": ["template", "edits"], "properties": {
      "template": {"type": "string", "minLength": 1}, "edits": {"type": "array", "items": {"$ref": "#/$defs/edit"}}
    }}
  }
}
