{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ftms:measurements:conformance:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "specificationBasis",
    "fieldOrder",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "specificationBasis": {
      "type": "string",
      "minLength": 1
    },
    "fieldOrder": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "speed",
          "averageSpeed",
          "distance",
          "inclination",
          "rampAngle",
          "positiveElevation",
          "negativeElevation",
          "instantaneousPace",
          "averagePace",
          "energy",
          "energyPerHour",
          "energyPerMinute",
          "heartRate",
          "met",
          "elapsed",
          "remaining",
          "force",
          "power",
          "stepRate",
          "averageStepRate",
          "strideCount",
          "resistance",
          "averagePower",
          "floorCount",
          "stepCount",
          "strokeRate",
          "strokeCount",
          "averageStrokeRate",
          "cadence",
          "averageCadence"
        ]
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "byte": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "mask": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1073741823
    },
    "flag": {
      "type": "integer",
      "enum": [
        0,
        1
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "decoded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "flags",
        "present",
        "unavailable",
        "values",
        "moreData",
        "backward",
        "truncated",
        "trailingBytes",
        "reservedFlags",
        "bytesRead"
      ],
      "properties": {
        "kind": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "flags": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "present": {
          "$ref": "#/$defs/mask"
        },
        "unavailable": {
          "$ref": "#/$defs/mask"
        },
        "values": {
          "type": "array",
          "minItems": 30,
          "maxItems": 30,
          "items": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          }
        },
        "moreData": {
          "$ref": "#/$defs/flag"
        },
        "backward": {
          "$ref": "#/$defs/flag"
        },
        "truncated": {
          "$ref": "#/$defs/flag"
        },
        "trailingBytes": {
          "$ref": "#/$defs/flag"
        },
        "reservedFlags": {
          "$ref": "#/$defs/flag"
        },
        "bytesRead": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "integer",
          "enum": [
            2,
            3,
            4
          ]
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "bytes",
        "decoded",
        "encode"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "type": "integer",
          "minimum": -1,
          "maximum": 256
        },
        "bytes": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/byte"
          }
        },
        "decoded": {
          "oneOf": [
            {
              "$ref": "#/$defs/decoded"
            },
            {
              "$ref": "#/$defs/error"
            }
          ]
        },
        "encode": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
