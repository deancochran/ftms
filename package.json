{
  "name": "ftms-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "pnpm --filter @deancochran/ftms clean",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "pnpm --filter @deancochran/ftms test",
    "check-types": "pnpm --filter @deancochran/ftms check-types",
    "build": "pnpm --filter @deancochran/ftms build",
    "verify:package": "pnpm --filter @deancochran/ftms verify:package",
    "verify": "pnpm --filter @deancochran/ftms verify",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "lefthook": "^2.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0"
}
