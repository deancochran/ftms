{
  "name": "ftms-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "pnpm --filter @deancochran/ftms clean",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "pnpm --filter @deancochran/ftms test",
    "check-types": "pnpm --filter @deancochran/ftms check-types",
    "build": "pnpm --filter @deancochran/ftms build",
    "verify:package": "pnpm --filter @deancochran/ftms verify:package",
    "release:prepare": "node tools/release-prepare.mjs",
    "docs:check": "node --test tools/check-docs.test.mjs tools/port-catalog.test.mjs && node tools/check-docs.mjs",
    "docs:build": "pnpm --filter @deancochran/ftms docs:build",
    "site:dev": "pnpm docs:build && pnpm --filter @ftms/site dev",
    "site:build": "pnpm docs:build && pnpm --filter @ftms/site build",
    "site:preview": "pnpm --filter @ftms/site preview",
    "site:test:browser": "pnpm --filter @ftms/site test:browser",
    "site:verify": "pnpm lint && pnpm docs:check && pnpm --filter @ftms/site test && pnpm docs:build && pnpm --filter @ftms/site check && pnpm --filter @ftms/site build && pnpm --filter @ftms/site verify:output",
    "verify": "pnpm --filter @deancochran/ftms verify && pnpm docs:check && pnpm docs:build",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "lefthook": "^2.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0"
}
